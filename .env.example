# Copy this file to .env and fill in whichever provider keys you have.
# .env is gitignored — never commit real keys. Loaded automatically on
# backend startup (see src/api/main.py).

# Required for any Model in the Models tab with provider "anthropic".
ANTHROPIC_API_KEY=

# Required for provider "openai". No real client wired up for this yet
# (see src/agents/model_client.py) — calls fall back to the mock client.
OPENAI_API_KEY=

# Required for provider "google". No real client wired up for this yet —
# calls fall back to the mock client.
GOOGLE_API_KEY=

# Optional: comma-separated list of allowed frontend origins for CORS.
# Defaults to the Vite dev server (http://localhost:5173) if unset.
# CORS_ORIGINS=http://localhost:5173

# MCP server credentials — never entered in the UI or stored in the DB.
# An MCP server's env_passthrough (set in the Tools tab) lists which of these
# variable NAMES get forwarded into that server's process; the value always
# stays here, read straight from this backend's own environment.

# Slack MCP (@modelcontextprotocol/server-slack)
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=

# Notion MCP (@notionhq/notion-mcp-server) — a Notion internal integration token
NOTION_TOKEN=

# Jira MCP (mcp-atlassian, run via `uvx` — requires `uv` installed separately)
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
